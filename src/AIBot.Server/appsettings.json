{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "RuntimeFileEnabled": true,
    "RuntimeRetentionDays": 14,
    "ChatRetentionDays": 30,
    "AuditRetentionDays": 365,
    "MaintenanceIntervalHours": 24,
    "RuntimeDirectory": ""
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Json",
    "MySql": {
      "ConnectionString": "",
      "AutoMigrate": false
    },
    "MigrationGameId": "default"
  },
  "Llm": {
    "ApiKey": "",
    "_comment": "生产从环境变量 AIBOT_LLM_KEY 注入；此文件勿填真实 key"
  },
  "Security": {
    "AdminToken": "",
    "ClientToken": "",
    "ChatRequestsPerMinute": 60,
    "_comment": "部署时优先用环境变量 AIBOT_ADMIN_TOKEN / AIBOT_CLIENT_TOKEN；ClientToken 用于游戏客户端聊天 API"
  },
  "Sessions": {
    "MemoryIdleHours": 24
  },
  "Memory": {
    "MaxShortTermTurns": 50,
    "MaxSummaryThreshold": 200,
    "MaxFacts": 20,
    "AllowBackgroundSummarization": true,
    "SummaryQueueCapacity": 256,
    "RetentionDays": 90,
    "SupportedSummaryTriggers": ["message_count"],
    "SupportedMemoryScopes": ["session", "player_npc"]
  }
}
