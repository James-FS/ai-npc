# docker.yml / AIBot.Server 本地开发配置示例
AIBOT_MYSQL_ROOT_PASSWORD=change-me
AIBOT_MYSQL_DATABASE=ai_npc
AIBOT_MYSQL_USER=aibot
AIBOT_MYSQL_PASSWORD=change-me
AIBOT_MYSQL_PORT=3306

# OpenCode / 其他 OpenAI 兼容模型的 API Key（可选；不要提交真实值）
AIBOT_LLM_KEY=

# Server API tokens（正式部署请替换成长随机值）
AIBOT_ADMIN_TOKEN=
AIBOT_CLIENT_TOKEN=

# start-server-mysql.ps1 会读取以上配置，拼接 AIBot.Server 本地连接串。
# 同时会将 AIBOT_LLM_KEY 注入当前 Server 子进程。
# 若宿主机 3306 被占用，请将 AIBOT_MYSQL_PORT 改为 3307。

# MySQL 模式下启动时自动补齐缺失表（按 schema_migrations 版本）
AIBOT_MYSQL_AUTOMIGRATE=true
