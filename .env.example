# docker.yml / AIBot.Server 本地开发配置示例

# ---- MongoDB（正式存储）----
AIBOT_MONGO_USER=aibot
AIBOT_MONGO_PASSWORD=change-me
AIBOT_MONGO_PORT=27017
AIBOT_MONGO_DATABASE=ai_npc
# Mongo 模式必须为 true：Server 启动时创建集合与索引
AIBOT_MONGO_AUTOMIGRATE=true

# OpenCode / 其他 OpenAI 兼容模型的 API Key（可选；不要提交真实值）
AIBOT_LLM_KEY=

# Server API tokens（正式部署请替换成长随机值）
AIBOT_ADMIN_TOKEN=
AIBOT_CLIENT_TOKEN=

# start-server-mongo.ps1 会读取以上配置，拼接 AIBot.Server 本地连接串，
# 并把 AIBOT_LLM_KEY 注入当前 Server 子进程。
# 若宿主机 27017 被占用，请调整 AIBOT_MONGO_PORT。
